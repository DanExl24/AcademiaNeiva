# =============================================
# AcademiaNeiva — Backend .env.example
# Copia este archivo como .env y rellena tus valores
# =============================================

PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=AcademiaNeiva

# Configuracion de Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=TU_APP_PASSWORD_AQUI

# JWT
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_64_CHARS

# URLs
FRONTEND_URL=https://academianeiva.adsoproject.dev
ALLOWED_ORIGINS=https://academianeiva.adsoproject.dev,http://localhost:5173,http://localhost:3000