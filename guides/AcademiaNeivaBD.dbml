Table "configuracion_inscripcion" {
  "id_configuracion" integer [pk, not null]
  "id_colegio" integer [not null]
  "id_anio" integer [not null]
  "fecha_inicio" timestamp [not null]
  "fecha_cierre" timestamp [not null]
  "habilitada" boolean [not null, default: true]

  Checks {
    `(fecha_cierre > fecha_inicio)` [name: 'chk_fechas']
  }

  Indexes {
    (id_colegio, id_anio) [unique, name: "uq_colegio_anio"]
    id_colegio [type: btree, name: "idx_config_inscripcion_colegio"]
  }
}

