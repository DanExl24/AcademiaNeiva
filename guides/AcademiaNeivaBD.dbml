  "valor_default" "character varying(255)" [not null]
  "tipo" "character varying(20)" [not null]
}

Table "configuracion_colegio" {
  "id_colegio" integer [pk, not null]
  "nota_minima" numeric(5,2) [not null, default: 0]
  "nota_maxima" numeric(5,2) [not null, default: 5]
  "nota_aprobacion" numeric(5,2) [not null, default: 3]
  "escala_modo" "character varying(20)" [not null, default: `'AUTOMATICO'::charactervarying`]
