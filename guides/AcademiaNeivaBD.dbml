  }
}

Table "notas_actividad" {
  "id_notaactividad" integer [pk, not null]
  "id_actividadmateria" integer [not null]
  "id_estudiante" integer [not null]
  "id_escalavaloracion" integer [not null]
  "nota" numeric(5,2) [not null]
  "id_colegio" integer [not null]

  Indexes {
    (id_actividadmateria, id_estudiante) [unique, name: "unique_actividad_estudiante"]
    id_actividadmateria [type: btree, name: "idx_notas_actividad"]
    id_estudiante [type: btree, name: "idx_notas_estudiante"]
  }
}

Table "notificacion_colegio" {
  "id_notificacion" integer [pk, not null]
  "id_colegio" integer [not null]
  "id_directivo" integer [not null]
  "tipo" "character varying(50)" [not null]
  "mensaje" text [not null]
  "estado_anterior" "character varying(20)"
  "estado_nuevo" "character varying(20)"
  "leida" boolean [not null, default: false]
  "fecha_notificacion" timestamp [not null, default: `now()`]

  Indexes {
    id_colegio [type: btree, name: "idx_notif_col_colegio"]
    id_directivo [type: btree, name: "idx_notif_col_directivo"]
    leida [type: btree, name: "idx_notif_col_leida"]
  }
}

Table "notificacion_supervision" {
  "id_notificacion" integer [pk, not null]
  "id_auditoria" integer [not null]
  "id_directivo" integer [not null]
  "tipo_notificacion" "character varying(50)" [not null]
  "mensaje" text [not null]
  "leida" boolean [not null, default: false]
  "fecha_notificacion" timestamp [not null, default: `now()`]

  Indexes {
    id_auditoria [type: btree, name: "idx_notif_sup_auditoria"]
    id_directivo [type: btree, name: "idx_notif_sup_directivo"]
    leida [type: btree, name: "idx_notif_sup_leida"]
  }
}

Table "observacion_estudiante" {
  "id_observacion" integer [pk, not null]
  "id_estudiante" integer [not null]
  "id_detallegrado" integer [not null]
  "id_periodo" integer [not null]
  "fortalezas" text
  "debilidades" text
  "recomendaciones" text
  "fecha" timestamp [not null]
  "id_colegio" integer [not null]
  "tipo" tipo_observacion [default: `'ACADEMICA'::public.tipo_observacion`]

  Indexes {
    id_estudiante [type: btree, name: "idx_observacion_estudiante"]
  }
}

Table "padre_familia" {
  "id_padrefamilia" integer [pk, not null]
  "nombre" "character varying(50)" [not null]
  "apellido" "character varying(50)" [not null]
  "id_colegio" integer
  "id_usuario" integer [unique]
}

Table "papelera_materias" {
  "id_papelera" integer [pk, not null]
  "id_colegio" integer
  "nombre_materia" "character varying(255)"
  "data_respaldo" jsonb
  "fecha_borrado" timestamp [default: `CURRENT_TIMESTAMP`]
  "fecha_expiracion" timestamp [default: `CURRENT_TIMESTAMP+'30 days'::interval`]
}

Table "password_reset_tokens" {
  "id" integer [pk, not null]
  "id_usuario" integer [not null]
  "token" "character varying(255)" [unique, not null]
  "expires_at" timestamp [not null]
  "used" boolean [not null, default: false]
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    token [type: btree, name: "idx_password_reset_token"]
  }
}

Table "periodo_academico" {
  "id_periodo" integer [pk, not null]
  "nombre" "character varying(100)" [not null]
  "estado" estado_periodo [not null]
  "porcentaje" numeric(5,2) [not null]
  "id_anio" integer
  "id_colegio" integer [not null]
  "trimestre" integer
  "dia_inicio" integer
  "dia_fin" integer
  "mes_inicio" integer
  "mes_fin" integer
}

Table "registro_asistencia" {
  "id_registroasistencia" integer [pk, not null]
  "id_estudiante" integer [not null]
  "id_detallegrado" integer [not null]
  "fecha" timestamp [not null]
  "estado" estado_asistencia [not null, default: `'PRESENTE'::public.estado_asistencia`]
  "id_colegio" integer [not null]
  "justificacion" text
  "hora_llegada" time

  Indexes {
    id_estudiante [type: btree, name: "idx_asistencia_estudiante"]
  }
}

Table "registro_graduados" {
  "id_graduado" integer [pk, not null]
  "id_estudiante" integer [unique, not null]
  "fecha_graduacion" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "observaciones" text
  "id_usuario_registro" integer
  "creado_en" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "id_anio" integer
}

Table "resultado_academico" {
  "id_resultado" integer [pk, not null]
  "id_estudiante" integer [not null]
  "id_detallegrado" integer [not null]
  "id_periodo" integer [not null]
  "promedio" numeric(5,2) [not null]
  "estado" estado_resultado [not null]
  "fecha_cierre" timestamp [not null]
  "id_docente" integer [not null]
  "observacion" text
}

Table "rol" {
  "id_rol" integer [pk, not null]
  "nombre" "character varying(50)" [unique, not null]
}

Table "sancion" {
  "id_sancion" integer [pk, not null]
  "id_estudiante" integer [not null]
  "id_tipo_sancion" integer [not null]
  "motivo" text [not null]
  "fecha_inicio" date [not null, default: `CURRENT_DATE`]
  "fecha_fin" date [not null]
  "estado" estado_sancion [default: `'ACTIVA'::public.estado_sancion`]
  "observaciones" text
  "id_directivo" integer [not null]
  "creado_en" timestamp [default: `CURRENT_TIMESTAMP`]

  Checks {
    `(fecha_fin >= fecha_inicio)` [name: 'chk_fechas_sancion']
  }
}

Table "secciones" {
  "id_seccion" integer [pk, not null]
  "nombre" "character varying(10)" [unique, not null]
}

Table "solicitud_traslado" {
  "id_solicitud" integer [pk, not null]
  "tipo" tipo_traslado [not null, default: `'TRASLADO_USUARIO'::public.tipo_traslado`]
  "id_usuario" integer [not null]
  "id_colegio_origen" integer [not null]
  "id_colegio_destino" integer [not null]
  "id_matricula" integer
  "estado" estado_solicitud_traslado [not null, default: `'SOLICITADA'::public.estado_solicitud_traslado`]
  "motivo" text [not null]
  "creado_por" integer [not null]
  "fecha_creacion" timestamp [default: `CURRENT_TIMESTAMP`]
  "fecha_finalizacion" timestamp

  Checks {
    `(id_colegio_origen <> id_colegio_destino)` [name: 'chk_origen_destino_diff']
  }

  Indexes {
    id_colegio_destino [type: btree, name: "idx_solicitud_traslado_destino"]
    id_colegio_origen [type: btree, name: "idx_solicitud_traslado_origen"]
    id_usuario [type: btree, name: "idx_solicitud_traslado_usr"]
  }
}

Table "tickets_soporte" {
  "id_ticket" integer [pk, not null]
  "id_usuario" integer
  "nombre_remitente" "character varying(155)" [not null]
  "correo_remitente" "character varying(155)" [not null]
  "telefono" "character varying(50)"
  "tipo_incidencia" tipo_incidencia_soporte [not null]
  "asunto" "character varying(255)" [not null]
  "descripcion" text [not null]
  "estado" estado_ticket_soporte [default: `'ABIERTO'::public.estado_ticket_soporte`]
  "fecha_creacion" timestamp [default: `CURRENT_TIMESTAMP`]
  "id_colegio" integer
  "observaciones" jsonb [default: `'[]'::jsonb`]
  "codigo_ticket" "character varying(50)" [unique]
  "fecha_escalado" timestamp
  "id_estudiante" integer

  Indexes {
    codigo_ticket [type: btree, name: "idx_tickets_codigo"]
    id_colegio [type: btree, name: "idx_tickets_colegio"]
    estado [type: btree, name: "idx_tickets_estado"]
    id_usuario [type: btree, name: "idx_tickets_usuario"]
  }
}

Table "tipo_documento" {
  "id_tipodocumento" integer [pk, not null]
  "tipo" "character varying(255)" [not null]
}

Table "tipo_grado" {
  "id_tipo_grado" integer [pk, not null]
  "nombre" "character varying(50)" [not null]
  "id_nivel" integer [not null]

  Indexes {
    (nombre, id_nivel) [unique, name: "uq_tipo_grado"]
  }
}

Table "tipo_sancion" {
  "id_tipo_sancion" integer [pk, not null]
  "nombre" "character varying(100)" [unique, not null]
  "descripcion" text
}

Table "token_blacklist" {
  "id" integer [pk, not null]
  "jti" "character varying(255)" [unique, not null]
  "expires_at" timestamp [not null]
  "created_at" timestamp [default: `now()`]

  Indexes {
    expires_at [type: btree, name: "idx_token_blacklist_expires_at"]
  }
}

Table "traslado_aprobacion" {
  "id_aprobacion" integer [pk, not null]
  "id_solicitud" integer [not null]
  "id_usuario" integer [not null]
  "rol" "character varying(50)" [not null]
  "accion" accion_aprobacion_traslado [not null]
  "comentario" text
  "fecha" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    id_solicitud [type: btree, name: "idx_traslado_aprobacion_sol"]
  }
}

Table "usuario" {
  "id_usuario" integer [pk, not null]
  "email" "character varying(255)" [unique]
  "password" "character varying(255)" [not null]
  "nombre" "character varying(255)" [not null]
  "apellido" "character varying(255)"
  "id_colegio" integer
  "activo" boolean [default: true]
  "fecha_creacion" timestamp [default: `now()`]
  "estado" estado_usuario_sistema [not null, default: `'ACTIVO'::public.estado_usuario_sistema`]
  "motivo_baneo" text
  "fecha_baneo" timestamp
  "baneado_por" integer
  "logged_out_at" timestamp
  "id_tipodocumento" integer
  "documento" "character varying(50)"
  "telefono" "character varying(50)"

  Checks {
    `((documento IS NULL) OR ((documento)::text ~ '^[a-zA-Z0-9]+$'::text))` [name: 'chk_usuario_documento_format']
  }

  Indexes {
    id_colegio [type: btree, name: "idx_usuario_colegio"]
    documento [type: btree, name: "idx_usuario_documento"]
    email [type: btree, name: "idx_usuario_email"]
    estado [type: btree, name: "idx_usuario_estado"]
  }
}

Table "usuario_colegio" {
  "id_usuario_colegio" integer [pk, not null]
  "id_usuario" integer [not null]
  "id_colegio" integer [not null]
  "id_rol" integer [not null]
  "estado" "character varying(20)" [not null, default: `'ACTIVO'::charactervarying`]
  "fecha_inicio" timestamp [default: `CURRENT_TIMESTAMP`]
  "fecha_fin" timestamp

  Checks {
    `((estado)::text = ANY ((ARRAY['ACTIVO'::character varying, 'INACTIVO'::character varying, 'SUSPENDIDO'::character varying])::text[]))` [name: 'usuario_colegio_estado_check']
  }

  Indexes {
    (id_usuario, id_colegio, id_rol) [unique, name: "uq_usuario_colegio_rol"]
    (id_usuario, id_colegio) [type: btree, name: "idx_usuario_colegio_activo"]
    id_colegio [type: btree, name: "idx_usuario_colegio_col"]
    id_usuario [type: btree, name: "idx_usuario_colegio_usr"]
  }
}

Table "usuario_rol" {
  "id_usuario" integer [not null]
  "id_rol" integer [not null]

  Indexes {
    (id_usuario, id_rol) [pk, name: "usuario_rol_pkey"]
  }
}

