  "id_grupo" integer [not null]
  "id_materia" integer [not null]
  "id_periodo" integer [not null]
  "descripcion" text [not null, default: `'Competencia pendiente por definir.'::text`]
  "id_colegio" integer [not null]
  "nombre" "character varying(200)"
  "sync_uuid" uuid
  "id_dimension" integer

  Indexes {
    sync_uuid [type: btree, name: "idx_competencias_sync_uuid"]
  }
}

Table "configuracion_base" {
  "id_config_base" integer [pk, not null]
  "clave" "character varying(100)" [unique, not null]
