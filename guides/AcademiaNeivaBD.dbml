Table "actividad_evidencia_dba" {
  "id_actividadmateria" integer [not null]
  "id_evidencia_dba" integer [not null]

  Indexes {
    (id_actividadmateria, id_evidencia_dba) [pk, name: "actividad_evidencia_dba_pkey"]
    id_actividadmateria [type: btree, name: "idx_actividad_evidencia_dba_act"]
    id_evidencia_dba [type: btree, name: "idx_actividad_evidencia_dba_ev"]
  }
}

Table "actividad_materia" {
  "id_actividadmateria" integer [pk, not null]
  "id_detallegrado" integer
  "id_periodo" integer
  "nombre" "character varying(255)" [not null]
  "porcentaje" numeric(5,2) [not null]
  "id_colegio" integer [not null]
  "id_competencia" integer
  "id_evidencia" integer
  "fecha_creacion" timestamp [default: `now()`]
  "motivo_extra" "character varying(100)" [default: `NULL::charactervarying`]
  "justificacion_extra" text
  "id_docente_creador" integer
}

Table "anio_lectivo" {
  "id_anio" integer [pk, not null]
  "calendario" "character varying(10)"
  "id_colegio" integer [not null]
  "tipo_calendario" character(1) [default: `'A'::bpchar`]
  "estado" estado_periodo [default: `'ABIERTO'::public.estado_periodo`]
  "fecha_inicio" date
  "fecha_fin" date

  Checks {
    `((calendario)::text ~ '^[0-9]{4}(-[0-9]{4})?$'::text)` [name: 'chk_calendario']
  }
}

Table "auditoria_acciones_realizadas" {
  "id_accion" integer [pk, not null]
  "id_auditoria" integer [not null]
  "fecha_accion" timestamp [not null, default: `now()`]
  "modulo" "character varying(255)" [not null]
  "tipo_accion" tipo_accion_auditoria [not null]
  "accion" "character varying(255)" [not null]
  "recurso_afectado" text [not null]
  "id_usuario_afectado" integer
  "valor_antiguo" jsonb
  "valor_nuevo" jsonb
  "motivo_cambio" text

  Checks {
    `((tipo_accion <> 'MODIFICACION'::public.tipo_accion_auditoria) OR ((valor_antiguo IS NOT NULL) AND (valor_nuevo IS NOT NULL) AND (motivo_cambio IS NOT NULL)))` [name: 'chk_modificacion_completa']
  }

  Indexes {
    id_auditoria [type: btree, name: "idx_audit_acc_auditoria"]
    fecha_accion [type: btree, name: "idx_audit_acc_fecha"]
    tipo_accion [type: btree, name: "idx_audit_acc_tipo"]
    id_usuario_afectado [type: btree, name: "idx_audit_acc_usuario"]
  }
}

Table "auditoria_supervision" {
  "id_auditoria" integer [pk, not null]
  "id_admin_general" integer [not null]
  "id_colegio" integer [not null]
  "id_directivo_aprobador" integer
  "motivo_solicitud" text [not null]
  "fecha_solicitud" timestamp [not null, default: `now()`]
  "tipo_supervision" tipo_supervision [not null]
  "estado_supervision" estado_supervision [not null, default: `'SOLICITADA'::public.estado_supervision`]
  "fecha_aprobacion" timestamp
  "motivo_entrada" text
  "fecha_entrada" timestamp
  "fecha_salida" timestamp
  "duracion_maxima_minutos" integer [not null, default: 60]
  "revocado_por" integer
  "fecha_revocacion" timestamp
  "ip_admin" "character varying(45)"
  "eliminado" boolean [not null, default: false]
  "fecha_retencion_hasta" timestamp [not null, default: `now()+'5 years'::interval`]
  "motivo_revocacion" text

  Indexes {
    id_admin_general [type: btree, name: "idx_audit_sup_admin"]
    id_colegio [type: btree, name: "idx_audit_sup_colegio"]
    eliminado [type: btree, name: "idx_audit_sup_eliminado"]
    estado_supervision [type: btree, name: "idx_audit_sup_estado"]
    fecha_solicitud [type: btree, name: "idx_audit_sup_fecha"]
  }
}

Table "cierre_materia" {
  "id_cierremateria" integer [pk, not null]
